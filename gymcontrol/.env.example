# Supabase > Connect > Session pooler (IPv4)
# Transforme postgresql:// em jdbc:postgresql:// e mantenha o host/porta/banco.
SPRING_DATASOURCE_URL=jdbc:postgresql://SEU-HOST-POOLER:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.SEUS_PROJECT_REF
SPRING_DATASOURCE_PASSWORD=SUA_SENHA_DO_BANCO

# Gere uma chave aleatória longa (mínimo 32 caracteres)
JWT_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_FORTE
JWT_EXPIRATION=900000
DB_POOL_SIZE=5
PORT=3000
